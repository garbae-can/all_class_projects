body  { 
    background-color: mediumpurple;
}

#container {
    background-color: mintcream;
    width: 450px;
    margin:20px auto;
    border: 2px soild black;
    padding: 20px;
    border-radius: 20px;

}

header {
    text-align: center;
    padding: 50px;
}

header h1 {
    color: mediumpurple;
    font-size: 30px;
    
}
    
nav {
    text-align: center;
    border-top: 4px soild black;
    border-bottom: 4px soild black;
    padding: 20px;
}

nav a {
    color: cornflowerblue;
    font-size: 30px;
    margin: 0 20px;

}

nav a:hover {
    color: colcdssgray;
    text-decoration: none;
}

main h2{
display: block;
margin: 20px auto;
width: 600px;

}

footer {
padding: 40px 0;
text-align: center;
border-top: 4px solid ;
}